   "source": [
    "from pycorr import TwoPointCorrelationFunction, utils\n",
    "import os\n",
    "import numpy as np\n",
    "import glob\n",
    "from itertools import combinations_with_replacement\n",
    "def get_corr_small_boxes_tr(tracers, corr_dir, zsim, fit_type, **kwargs):\n",
    "\n",
    "    com_tr = np.asarray(\n",
    "                list(combinations_with_replacement(sorted(set(tracers)), 2)),\n",
    "                dtype=str,\n",
    "            ).reshape(-1, 2)\n",
    "    str_tr_all = '_'.join(map(str, np.unique(com_tr)))\n",
    "    corr_fn = os.path.join(corr_dir, f'z{zsim:.3f}', f'Mcorr_small_box_z{zsim}_{fit_type}_{str_tr_all}.txt')\n",
    "\n",
    "    if os.path.exists(corr_fn):\n",
    "        print(f'Load correlation matrix for {str_tr_all} at z{zsim} ...', flush=True)\n",
    "        corr = np.loadtxt(corr_fn)\n",
    "        # return corr\n",
    "    print(f'Load correlation matrix for {str_tr_all}...', flush=True)\n",
    "    corr_type = []\n",
    "    if 'wp' in fit_type:\n",
    "        corr_type += ['rppi']\n",
    "    if 'xi' in fit_type:\n",
    "        corr_type += ['smu']\n",
    "    if 'delta_sigma' in fit_type:\n",
    "        corr_type += ['delta_sigma']\n",
    "\n",
    "    res = []\n",
    "    for tr in com_tr:\n",
    "        str_tr = '_'.join(map(str, tr))\n",
    "        file_name = f'*{str_tr}_AbacusSummit_small_c000_ph*'\n",
    "        file_dir = os.path.join(corr_dir, f'z{zsim:.3f}', '{}', file_name)\n",
    "\n",
    "        res_tr = []\n",
    "        for corr_t in corr_type:\n",
    "            if os.path.exists(os.path.join(file_dir.format(corr_t, str_tr))):\n",
    "                pass\n",
    "            else:\n",
    "                str_tr = '_'.join(map(str, np.unique(tr)[::-1]))\n",
    "            fns = glob.glob(os.path.join(file_dir.format(corr_t, str_tr)))\n",
    "            print(file_dir.format(corr_t, str_tr))\n",
    "            if len(fns) == 0:\n",
    "                if corr_t == 'delta_sigma' and (tr[0] != tr[1]):\n",
    "                    print(f'No {corr_t} measurements at z{zsim} for {str_tr}... but this is expected for cross-tracer delta_sigma, skipping.', flush=True)\n",
    "                    res_tr += []\n",
    "                    break\n",
    "                raise FileNotFoundError(f'No {corr_t} measurements at z{zsim} for {str_tr}...')\n",
    "            print(f'Load {corr_t} measurements at z{zsim} for {str_tr}...', flush=True)\n",
    "            if corr_t == 'rppi':\n",
    "                res_tr += [[TwoPointCorrelationFunction.load(file)[::2][4:-3](pimax=40) for file in fns]]\n",
    "            elif corr_t == 'smu':\n",
    "                res_tr += [[np.hstack(TwoPointCorrelationFunction.load(file)[16:-6](ells=[0,2])) for file in fns]]\n",
    "            elif corr_t == 'delta_sigma':\n",
    "                if tr[0] == tr[1]:\n",
    "                    res_tr += [[np.loadtxt(file)[1] for file in fns]]\n",
    "                else:\n",
    "                    pass\n",
    "        # print(len(glob.glob(f'/global/cfs/cdirs/desi/users/arocher/Y1/2PCF_for_corr/Abcaus_small_boxes/z{zsim:.3f}/smu/allcounts_{zsim}_AbacusSummit_small_c000_ph*.npy')))\n",
    "        # return 0\n",
    "        if len(res_tr) > 0:\n",
    "            res += [np.hstack(res_tr)]        \n",
    "    covmat = np.cov(np.hstack(res), rowvar=False, ddof=0)\n",
    "    corr = utils.cov_to_corrcoef(covmat)\n",
    "    np.savetxt(os.path.join(corr_dir, f'z{zsim:.3f}', f'Mcorr_small_box_z{zsim}_{fit_type}_{str_tr_all}.txt'), corr)\n",
    "    np.savetxt(os.path.join(corr_dir, f'z{zsim:.3f}', f'Mcov_small_box_z{zsim}_{fit_type}_{str_tr_all}.txt'), covmat)\n",
    "\n",
    "    return corr"
   ]
  },
