    "#         self.data           = np.asarray(data_vec)\n",
    "#         self.inv_cov        = np.asarray(inv_cov)\n",
    "#         self.param_names    = list(param_names)\n",
    "#         self.n_realizations = n_realizations\n",
    "#         self.base_seed      = base_seed\n",
    "\n",
    "#     def _seed_for(self, theta):\n",
    "#         \"\"\"Graine déterministe en theta : supprime le bruit entre appels.\"\"\"\n",
    "#         key = np.asarray(theta, dtype=np.float64).round(10).tobytes()\n",
    "#         return (hash(key) ^ self.base_seed) % (2**31 - 1)\n",
    "\n",
    "#     def __call__(self, theta):\n",
    "#         params = dict(zip(self.param_names, np.atleast_1d(theta)))\n",
    "#         seed   = self._seed_for(theta)\n",
